{
  "name": "kumoyomi",
  "version": "0.4.4",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.15.1",
  "description": "KumoYomi — 100% local full-page browser extension manga aggregator and reader (Firefox & Chrome)",
  "scripts": {
    "postinstall": "wxt prepare",
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "build:firefox:amo": "KUMOYOMI_AMO_LISTED=1 wxt build -b firefox",
    "zip": "wxt zip && wxt zip -b firefox",
    "zip:firefox:amo": "KUMOYOMI_AMO_LISTED=1 wxt zip -b firefox",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "preview:web": "vite --config vite.web.config.ts --host 127.0.0.1 --port 4178",
    "convert:mihon": "node tools/mihon-converter/convert.mjs"
  },
  "dependencies": {
    "dexie": "^4.4.7",
    "dexie-react-hooks": "^4.4.0",
    "lucide-react": "1.74.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^22.15.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.1.4",
    "@wxt-dev/module-react": "^1.2.2",
    "jsdom": "^31.0.1",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.9.3",
    "vite": "^7.3.8",
    "vitest": "5.1.0",
    "wxt": "^0.21.5"
  }
}
